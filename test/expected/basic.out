-- basic.sql: extension/server/mapping/table setup, smoke SELECT, validator checks
\i test/loopback-setup.sql
-- test/loopback-setup.sql
--
-- Shared setup for the loopback regress suites: point all three "replicas"
-- at the same local instance.  Disjoint ctid slices still union to exactly
-- the whole table, so slicing/fan-out/merge are fully exercised on one
-- instance.  Idempotent, safe to \i at the top of any suite.
-- Idempotent by design (IF NOT EXISTS throughout, no DROP/CASCADE): this
-- file is \i'd at the top of every suite, and suites run sequentially
-- against the same regression database.
CREATE EXTENSION IF NOT EXISTS pg_replica_fanout_fdw;
CREATE SERVER IF NOT EXISTS loopback FOREIGN DATA WRAPPER pg_replica_fanout_fdw
  OPTIONS (replicas 'localhost:5432,localhost:5432,localhost:5432',
           consistency 'none');
CREATE USER MAPPING IF NOT EXISTS FOR CURRENT_USER SERVER loopback;
CREATE TABLE small_t (id int, name text);
INSERT INTO small_t VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');
CREATE FOREIGN TABLE small_ft (id int, name text)
  SERVER loopback OPTIONS (table_name 'small_t');
SELECT * FROM small_ft ORDER BY id;
 id | name 
----+------
  1 | a
  2 | b
  3 | c
  4 | d
  5 | e
(5 rows)

SELECT * FROM small_ft
EXCEPT
SELECT * FROM small_t;
 id | name 
----+------
(0 rows)

-- validator: missing required "replicas" option
CREATE SERVER v_missing_replicas FOREIGN DATA WRAPPER pg_replica_fanout_fdw
  OPTIONS (dbname 'postgres');
ERROR:  option "replicas" is required for a pg_replica_fanout_fdw server
-- validator: consistency 'lsn' rejected (only 'none' is supported)
CREATE SERVER v_bad_consistency FOREIGN DATA WRAPPER pg_replica_fanout_fdw
  OPTIONS (replicas 'localhost', consistency 'lsn');
ERROR:  invalid value for option "consistency": "lsn"
HINT:  consistency='lsn' not supported; only 'none' is valid.
-- validator: unknown option name
CREATE SERVER v_bad_option FOREIGN DATA WRAPPER pg_replica_fanout_fdw
  OPTIONS (replicas 'localhost', bogus 'x');
ERROR:  invalid option "bogus"
HINT:  Valid options in this context: replicas, dbname, fetch_size, connect_timeout, application_name, consistency
